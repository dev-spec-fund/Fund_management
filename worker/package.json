{
  "name": "kys-fund-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute kys-fund-db --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute kys-fund-db --remote --file=./schema.sql",
    "tail": "wrangler tail",
    "db:backup": "bash ./scripts/backup.sh"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
