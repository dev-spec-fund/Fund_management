{
  "name": "fund-management-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram fund management bot on Cloudflare Workers (grammY + D1)",
  "main": "index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:apply": "wrangler d1 execute fund-management-db --remote --file=./schema.sql",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.90.0"
  }
}
